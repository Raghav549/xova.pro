# ---------------------------------------------------------------------------
# Xova — optional configuration
#
# Xova runs with NO configuration: the deterministic build engine works in the
# browser. Add an LLM key only when you want free-form generation from a model.
# You can also paste a key at runtime in Studio → Build settings (stored in the
# browser only, never on the server).
# ---------------------------------------------------------------------------

# Anthropic (default when present)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# Any OpenAI-compatible endpoint (Groq, OpenRouter, Together, Ollama, vLLM…)
XOVA_COMPATIBLE_API_KEY=
XOVA_BASE_URL=https://api.groq.com/openai/v1

# Generic fallback used when a provider-specific key is absent
XOVA_API_KEY=

# Disable client-side project history (IndexedDB) if you need a stateless deploy
# VITE_DISABLE_PERSISTENCE=1
